[Unit]
Description=NotifySound daemon
After=graphical-session.target

[Service]
ExecStart="%h/.local/bin/notify-sound" --daemon
Environment=PATH=/usr/local/bin:/usr/bin:/bin
Restart=on-failure
RestartSec=2
NoNewPrivileges=yes
PrivateTmp=yes
MemoryMax=256M
TasksMax=64

[Install]
WantedBy=default.target
