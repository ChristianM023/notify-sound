#!/usr/bin/env python3
import os
import sys

sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))

USAGE = """NotifySound: reproduce sonidos para notificaciones que no traen sonido.

Uso:
  notify-sound             Abre la interfaz gráfica
  notify-sound --daemon    Inicia el daemon en segundo plano
  notify-sound --quit      Detiene el daemon
  notify-sound --version   Muestra la versión
"""


def main():
    args = sys.argv[1:]
    if "--daemon" in args:
        from notify_sound.daemon import main_daemon

        return main_daemon()
    if "--quit" in args:
        from notify_sound.daemon import quit_daemon

        return quit_daemon()
    if "--version" in args:
        from notify_sound import __version__

        print(f"NotifySound {__version__}")
        return 0
    if "--help" in args or "-h" in args:
        print(USAGE)
        return 0
    from notify_sound.gui import main_gui

    return main_gui()


if __name__ == "__main__":
    sys.exit(main())
